# ---- Database (MySQL 8 / MariaDB 10.4+) ----
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASS=123
DB_NAME=jpl_auction
# Set to true for cloud MySQL that requires TLS
DB_SSL=false
DB_POOL_SIZE=10

# ---- Server ----
PORT=3000
# REQUIRED: long random string (at least 16 characters). The server refuses to start without it.
JWT_SECRET=123456789abcdef123456789abcdef12
# Restrict API/socket origins in production if the client is served elsewhere (default *)
CORS_ORIGIN=*

# ---- Bootstrap admin (created only when no admin exists) ----
ADMIN_LOGIN_ID=ADMIN001
ADMIN_EMAIL=admin@jpl.com
ADMIN_PASSWORD=admin@123

# ---- Auction timer (seconds) ----
AUCTION_INITIAL_SECONDS=30
AUCTION_BID_RESET_SECONDS=15
# true = at 00:00 the lot closes automatically (SOLD to the highest bidder, else UNSOLD)
AUCTION_AUTO_FINALIZE=true
