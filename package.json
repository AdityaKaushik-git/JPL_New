{
  "name": "jpl_jcc",
  "version": "2.0.0",
  "description": "JPL — JCC Cricket Sports Meet real-time player auction platform",
  "main": "server/server.js",
  "scripts": {
    "start": "node database/migrate.js && node server/server.js",
    "start:server": "node server/server.js",
    "dev": "node server/server.js",
    "migrate": "node database/migrate.js",
    "seed": "node database/migrate.js && node database/seed.js",
    "build": "cd client && npm install && npm run build",
    "test": "node --test tests/*.test.js"
  },
  "keywords": [
    "cricket",
    "auction",
    "socket.io"
  ],
  "author": "Aditya Kaushik",
  "license": "ISC",
  "type": "commonjs",
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "mysql2": "^3.24.4",
    "socket.io": "^4.8.3"
  },
  "devDependencies": {
    "socket.io-client": "^4.8.3"
  }
}
